[Unit]
Description=AGY Bridge Service for Shorts Factory
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/n8n/shorts_factory
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/root
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /opt/n8n/shorts_factory/scripts/agy_bridge.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
