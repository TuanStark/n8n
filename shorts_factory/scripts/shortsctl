#!/usr/bin/env python3
"""
shortsctl - Enterprise CLI for Multi-Channel AI Shorts Factory
Seamlessly orchestrate video production, channel personas, and Cloudinary offloading via AGY Engine.
"""

import sys
import os
import json
import time
import argparse
import urllib.request
import urllib.error

API_BASE = os.environ.get("SHORTS_FACTORY_API", "http://127.0.0.1:4100")

# ANSI Color Codes for terminal
RESET = "\033[0m"
BOLD = "\033[1m"
GREEN = "\033[32m"
CYAN = "\033[36m"
YELLOW = "\033[33m"
RED = "\033[31m"
MAGENTA = "\033[35m"
DIM = "\033[2m"

def print_banner():
    banner = f"""
{CYAN}{BOLD}╔═══════════════════════════════════════════════════════════════════════════════╗
║                   AI SHORTS FACTORY — MULTI-CHANNEL CLI                       ║
║        Powered by Google Antigravity (AGY) Engine & Cloudinary CDN            ║
╚═══════════════════════════════════════════════════════════════════════════════╝{RESET}
"""
    print(banner)

def make_request(method: str, path: str, payload: dict = None, timeout: int = 300) -> dict:
    url = f"{API_BASE}{path}"
    data = None
    headers = {"Content-Type": "application/json"}
    
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")

    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as response:
            res_data = response.read().decode("utf-8")
            return json.loads(res_data)
    except urllib.error.HTTPError as e:
        error_body = e.read().decode("utf-8")
        try:
            parsed = json.loads(error_body)
            return {"success": False, "error": parsed.get("error", str(e))}
        except Exception:
            return {"success": False, "error": f"HTTP {e.code}: {error_body or str(e)}"}
    except urllib.error.URLError as e:
        return {"success": False, "error": f"Cannot connect to Shorts Factory API at {API_BASE}: {e.reason}"}
    except Exception as e:
        return {"success": False, "error": str(e)}

def cmd_channels(args):
    print(f"{BOLD}Fetching registered channels from Shorts Factory...{RESET}\n")
    res = make_request("GET", "/api/v2/channels")
    if not res.get("success"):
        print(f"{RED}✖ Error:{RESET} {res.get('error')}")
        sys.exit(1)

    channels = res.get("data", [])
    if not channels:
        print(f"{YELLOW}No channels found.{RESET}")
        return

    print(f"{'CHANNEL ID':<22} | {'CHANNEL NAME':<32} | {'GENRE':<18} | {'OAUTH'}")
    print("-" * 85)
    for c in channels:
        cid = c.get("id", "")
        name = c.get("name", "")[:30]
        genre = c.get("genre_key", "")
        has_oauth = f"{GREEN}Connected{RESET}" if c.get("has_credentials") else f"{DIM}Unset{RESET}"
        print(f"{CYAN}{cid:<22}{RESET} | {name:<32} | {genre:<18} | {has_oauth}")
    print("\n" + f"{DIM}Total: {len(channels)} active channels registered.{RESET}")

def cmd_genres(args):
    print(f"{BOLD}Fetching registered Genre DNA Profiles...{RESET}\n")
    res = make_request("GET", "/api/v2/genres")
    if not res.get("success"):
        print(f"{RED}✖ Error:{RESET} {res.get('error')}")
        sys.exit(1)

    genres = res.get("data", [])
    for g in genres:
        gid = g.get("id")
        name = g.get("name")
        desc = g.get("description", "No description")
        tts_voice = g.get("tts_voice_id", "Default")
        soundscape = g.get("soundscape_preset", "Default")
        print(f"{MAGENTA}{BOLD}[{gid}]{RESET} {BOLD}{name}{RESET}")
        print(f"  {DIM}Description:{RESET} {desc}")
        print(f"  {DIM}Voice Actor:{RESET} {tts_voice}  |  {DIM}Soundscape:{RESET} {soundscape}")
        print()

def cmd_produce(args):
    channel_id = args.channel
    topic = args.topic
    privacy = args.privacy
    publish_yt = not args.no_youtube
    purge_local = not args.no_purge

    print(f"{BOLD}Initiating Multi-Channel Production Pipeline...{RESET}")
    print(f"  • {BOLD}Channel ID:{RESET} {CYAN}{channel_id}{RESET}")
    print(f"  • {BOLD}Topic:{RESET} {YELLOW}\"{topic}\"{RESET}")
    print(f"  • {BOLD}YouTube Publish:{RESET} {GREEN if publish_yt else DIM}{publish_yt}{RESET}")
    print(f"  • {BOLD}Zero-Local Purge (Cloudinary only):{RESET} {GREEN}{purge_local}{RESET}\n")

    payload = {
        "channelId": channel_id,
        "content": {
            "title": topic,
            "category": "auto",
        },
        "options": {
            "publishYouTube": publish_yt,
            "uploadCloudinary": True,
            "purgeLocalAfterUpload": purge_local,
            "privacyStatus": privacy,
        }
    }

    print(f"{CYAN}⏳ Pipeline executing: AGY Scriptwriter → Asset Synthesis → FFmpeg Compositor → Cloudinary...{RESET}")
    start_time = time.time()
    res = make_request("POST", "/api/v2/pipeline/produce", payload=payload, timeout=600)
    elapsed = time.time() - start_time

    if not res.get("success"):
        print(f"\n{RED}{BOLD}✖ Production Failed:{RESET} {res.get('error')}")
        sys.exit(1)

    data = res.get("data", {})
    print(f"\n{GREEN}{BOLD}✔ Video Produced & Processed Successfully in {elapsed:.1f}s!{RESET}\n")
    print(f"  • {BOLD}Job ID / Topic ID:{RESET} {data.get('topicId')}")
    print(f"  • {BOLD}Channel Name:{RESET}      {data.get('channelName')}")
    print(f"  • {BOLD}Duration:{RESET}          {data.get('durationSec')}s")
    print(f"  • {BOLD}QC Status:{RESET}         {GREEN if data.get('qcResult', {}).get('overallStatus') == 'PASS' else YELLOW}{data.get('qcResult', {}).get('overallStatus', 'UNKNOWN')}{RESET}")
    
    cloud_url = data.get("cloudinaryUrl")
    if cloud_url:
        print(f"\n  {MAGENTA}{BOLD}🌐 Cloudinary CDN URL (Zero Local Footprint):{RESET}")
        print(f"     {CYAN}{cloud_url}{RESET}")
    else:
        print(f"\n  {YELLOW}⚠️ Cloudinary URL not returned. Check .env CLOUDINARY_* configuration.{RESET}")

    yt_url = data.get("youtubeUrl")
    if yt_url:
        print(f"\n  {RED}{BOLD}▶ YouTube Shorts URL:{RESET}")
        print(f"     {yt_url}")

    if data.get("purgedLocalDisk"):
        print(f"\n  {GREEN}🧹 Zero-Local Storage Guarantee:{RESET} All local temp frames & render MP4 auto-purged from server disk.")

def cmd_status(args):
    print(f"{BOLD}Querying Shorts Factory System Status...{RESET}\n")
    res = make_request("GET", "/health")
    if not res.get("success", True) and "status" not in res:
        print(f"{RED}✖ Service Unreachable:{RESET} {res.get('error')}")
        sys.exit(1)

    print(f"  • {BOLD}Service Status:{RESET}   {GREEN}{res.get('status', 'ok')}{RESET}")
    print(f"  • {BOLD}Environment:{RESET}      {res.get('env')}")
    print(f"  • {BOLD}Database:{RESET}         {GREEN}{res.get('database')}{RESET}")
    print(f"  • {BOLD}Database Time:{RESET}    {res.get('dbTime')}")

    # Check AGY bridge
    try:
        with urllib.request.urlopen("http://127.0.0.1:4150/health", timeout=3) as agy_res:
            agy_data = json.loads(agy_res.read().decode())
            print(f"  • {BOLD}AGY Bridge:{RESET}       {GREEN}Online ({agy_data.get('binary')}){RESET}")
    except Exception as e:
        print(f"  • {BOLD}AGY Bridge:{RESET}       {YELLOW}Offline / Unreachable ({e}){RESET}")

def main():
    parser = argparse.ArgumentParser(
        prog="shortsctl",
        description="Enterprise CLI for Multi-Channel AI Shorts Factory"
    )
    subparsers = parser.add_subparsers(dest="command", help="Available subcommands")

    # Command: channels
    subparsers.add_parser("channels", help="List all registered channels and credentials")

    # Command: genres
    subparsers.add_parser("genres", help="List all visual and directorial genre profiles")

    # Command: status
    subparsers.add_parser("status", help="Inspect system health, DB, Redis and AGY Bridge")

    # Command: produce
    prod_parser = subparsers.add_parser("produce", help="Produce a short for a specific channel")
    prod_parser.add_argument("-c", "--channel", required=True, help="Target channel ID (e.g. channel_01_paper, channel_02_tech, channel_03_stoic)")
    prod_parser.add_argument("-t", "--topic", required=True, help="Topic or title for video generation")
    prod_parser.add_argument("-p", "--privacy", default="unlisted", choices=["private", "unlisted", "public"], help="YouTube privacy status (default: unlisted)")
    prod_parser.add_argument("--no-youtube", action="store_true", help="Skip YouTube upload (only render & upload to Cloudinary)")
    prod_parser.add_argument("--no-purge", action="store_true", help="Keep local files (disable auto-purge)")

    args = parser.parse_args()

    if not args.command:
        print_banner()
        parser.print_help()
        sys.exit(0)

    if args.command == "channels":
        cmd_channels(args)
    elif args.command == "genres":
        cmd_genres(args)
    elif args.command == "produce":
        cmd_produce(args)
    elif args.command == "status":
        cmd_status(args)

if __name__ == "__main__":
    main()
