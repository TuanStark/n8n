{
  "name": "[SHORTS-FACTORY] WF01_Shorts_Production_Orchestrator",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "1a2b3c4d-0001-4000-8000-000000000001",
      "name": "Daily Shorts Schedule (9:00 AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "http://shorts-factory-worker:4100/health",
        "options": {}
      },
      "id": "1a2b3c4d-0002-4000-8000-000000000002",
      "name": "Check Worker & DB Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "health-check-cond",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "1a2b3c4d-0003-4000-8000-000000000003",
      "name": "Is Worker Healthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://shorts-factory-worker:4100/api/pipeline/start",
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "1a2b3c4d-0004-4000-8000-000000000004",
      "name": "Trigger Shorts Pipeline (Auto-Select Topic)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 240]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "qc-pass-cond",
              "leftValue": "={{ $json.data.qcResult.overallStatus }}",
              "rightValue": "PASS",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "1a2b3c4d-0005-4000-8000-000000000005",
      "name": "Did QC Pass?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1160, 240]
    },
    {
      "parameters": {
        "chatId": "={{ $env.SLACK_CHANNEL_ID || 'D0BS0RNH37G' }}",
        "text": "=🎬 *[Paper Theater World] New Short Produced & QC Passed!*\n\n*Topic:* {{ $json.data.title }}\n*Duration:* {{ $json.data.durationSec }}s\n*Resolution:* 1080x1920 (9:16)\n*QC Status:* ✅ {{ $json.data.qcResult.overallStatus }}\n*Style Adherence:* {{ ($json.data.qcResult.aiVisionChecks.styleAdherenceScore * 100).toFixed(0) }}%\n\n*Video File:* `{{ $json.data.outputPath }}`\n*Status:* Ready for YouTube Publishing",
        "otherOptions": {}
      },
      "id": "1a2b3c4d-0006-4000-8000-000000000006",
      "name": "Notify Production Success (Slack/Telegram)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1400, 180]
    },
    {
      "parameters": {
        "chatId": "={{ $env.SLACK_CHANNEL_ID || 'D0BS0RNH37G' }}",
        "text": "=⚠️ *[Paper Theater World] Short Render Completed with QC Warning*\n\n*Topic:* {{ $json.data.title }}\n*Status:* {{ $json.data.qcResult.overallStatus }}\n*Issues:* {{ $json.data.qcResult.rejectionReasons.join(', ') }}\n\nNeeds manual review before publishing.",
        "otherOptions": {}
      },
      "id": "1a2b3c4d-0007-4000-8000-000000000007",
      "name": "Notify QC Warning",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1400, 320]
    },
    {
      "parameters": {
        "chatId": "={{ $env.SLACK_CHANNEL_ID || 'D0BS0RNH37G' }}",
        "text": "=🚨 *[Paper Theater World] Worker Health Check Failed!*\n\nService `shorts-factory-worker` is unreachable or PostgreSQL connection is down. Please verify Docker containers.",
        "otherOptions": {}
      },
      "id": "1a2b3c4d-0008-4000-8000-000000000008",
      "name": "Alert Worker Down",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [920, 420]
    }
  ],
  "connections": {
    "Daily Shorts Schedule (9:00 AM)": {
      "main": [
        [
          {
            "node": "Check Worker & DB Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Worker & DB Health": {
      "main": [
        [
          {
            "node": "Is Worker Healthy?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Worker Healthy?": {
      "main": [
        [
          {
            "node": "Trigger Shorts Pipeline (Auto-Select Topic)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alert Worker Down",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Shorts Pipeline (Auto-Select Topic)": {
      "main": [
        [
          {
            "node": "Did QC Pass?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Did QC Pass?": {
      "main": [
        [
          {
            "node": "Notify Production Success (Slack/Telegram)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notify QC Warning",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
