        "query": "=SELECT id, name, ad_copies->>'post_content' as post_content, ad_copies->'facebook_post'->>'full_post_content' as fb_content, ad_copies->'variation_a'->>'primary_text' as var_a\nFROM campaigns\nWHERE id = '{{ $json.campaign_id }}'\nLIMIT 1;"
