      "id": "node-respond",
      "name": "Respond 200 to Slack",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        320,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "// \u2500\u2500 Parse Slack Interactive Payload \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst rawBody = $input.first().json.body;\nlet slackPayload;\n\nif (typeof rawBody === 'string') {\n  const decoded = decodeURIComponent(rawBody.replace(/^payload=/, ''));\n  slackPayload = JSON.parse(decoded);\n} else if (rawBody && rawBody.payload) {\n  slackPayload = typeof rawBody.payload === 'string'\n    ? JSON.parse(rawBody.payload)\n    : rawBody.payload;\n} else {\n  slackPayload = rawBody || {};\n}\n\nconst action = slackPayload.actions?.[0] || {};\nconst actionId = action.action_id || 'unknown';\nconst actionValue = action.value || '{}';\nconst responseUrl = slackPayload.response_url;\nconst userName = slackPayload.user?.name || slackPayload.user?.username || 'B\u1ea1n';\nconst userId = slackPayload.user?.id || 'U_UNKNOWN';\n\nlet parsedValue = {};\ntry { parsedValue = JSON.parse(actionValue); } catch(e) {}\n\nlet replyMessage = `\u2705 \u0110\u00e3 ghi nh\u1eadn thao t\u00e1c c\u1ee7a @${userName}`;\nlet dbQuery = '';\nlet triggerCampaignWebhook = false;\nlet publishToFacebook = false;\nlet triggerShortApproval = false;\nlet shortId = parsedValue.shortId || null;\nlet shortAction = parsedValue.action || null;\nlet campaignId = parsedValue.campaign_id || null;\nlet targetOpportunityId = parsedValue.opportunity_id || null;\nlet directPostContent = parsedValue.post_content || '';\n\nif (actionId === 'approve_short') {\n  shortAction = 'APPROVE';\n  triggerShortApproval = true;\n  replyMessage = `\ud83d\ude80 *\u0110\u00c3 DUY\u1ec6T & \u0110ANG T\u1ef0 \u0110\u1ed8NG C\u00d4NG KHAI VIDEO L\u00caN YOUTUBE...*\\n> \ud83d\udc64 *Ph\u00ea duy\u1ec7t b\u1edfi:* @${userName} v\u00e0o l\u00fac ${new Date().toLocaleTimeString('vi-VN')}`;\n} else if (actionId === 'discard_short') {\n  shortAction = 'DISCARD';\n  triggerShortApproval = true;\n  replyMessage = `\ud83d\uddd1\ufe0f *\u0110\u00c3 H\u1ee6Y B\u1ece VIDEO N\u00c0Y.* \u2014 b\u1edfi @${userName}`;\n} else if (actionId === 'regenerate_short') {\n  shortAction = 'REGENERATE';\n  triggerShortApproval = true;\n  replyMessage = `\ud83d\udd04 *\u0110ANG Y\u00caU C\u1ea6U T\u1ea0O L\u1ea0I VIDEO...* \u2014 b\u1edfi @${userName}`;\n} else if (actionId === 'skip') {\n  replyMessage = `\u23ed\ufe0f *\u0110\u00e3 b\u1ecf qua b\u00e0i vi\u1ebft n\u00e0y.* \u2014 b\u1edfi @${userName}`;\n} else if (actionId === 'approve_ad_campaign') {\n  const campName = parsedValue.name || 'B\u00e0i vi\u1ebft Marketing';\n  replyMessage = `\ud83d\ude80 *\u0110\u00c3 DUY\u1ec6T & \u0110ANG T\u1ef0 \u0110\u1ed8NG \u0110\u0102NG B\u00c0I L\u00caN FACEBOOK:* [${campName}]\\n> \ud83d\udc64 *Ph\u00ea duy\u1ec7t b\u1edfi:* @${userName} v\u00e0o l\u00fac ${new Date().toLocaleTimeString('vi-VN')}`;\n  publishToFacebook = true;\n  if (campaignId) {\n    dbQuery = `UPDATE campaigns SET status = 'PUBLISHED', approved_by = '${userName}', approved_at = CURRENT_TIMESTAMP WHERE id = '${campaignId}';`;\n  }\n} else if (actionId === 'reject_ad_campaign') {\n  const campName = parsedValue.name || 'B\u00e0i vi\u1ebft Marketing';\n  replyMessage = `\u274c *\u0110\u00c3 T\u1eea CH\u1ed0I B\u00c0I VI\u1ebeT:* [${campName}] \u2014 b\u1edfi @${userName}`;\n  if (campaignId) {\n    dbQuery = `UPDATE campaigns SET status = 'REJECTED' WHERE id = '${campaignId}';`;\n  }\n} else if (actionId === 'claim_lead') {\n  replyMessage = `\ud83e\udd1d *Lead \u0111\u00e3 \u0111\u01b0\u1ee3c nh\u1eadn ph\u1ee5 tr\u00e1ch b\u1edfi:* @${userName}`;\n} else if (actionId === 'book_meeting') {\n  replyMessage = `\ud83d\udcc5 *\u0110\u00e3 chuy\u1ec3n tr\u1ea1ng th\u00e1i \u0110\u1eb7t l\u1ecbch t\u01b0 v\u1ea5n (Book Meeting) b\u1edfi:* @${userName}`;\n} else if (actionId === 'create_campaign_for_opportunity' || actionId === 'create_content_for_opportunity') {\n  replyMessage = `\u26a1 *\u0110ang t\u1ea1o B\u00e0i vi\u1ebft Marketing & \u0110\u1ec1 xu\u1ea5t Chi\u1ebfn d\u1ecbch cho C\u01a1 h\u1ed9i n\u00e0y...* (Y\u00eau c\u1ea7u b\u1edfi @${userName})`;\n  triggerCampaignWebhook = true;\n}\n\nreturn [{\n  json: {\n    action_id: actionId,\n    response_url: responseUrl,\n    user_name: userName,\n    user_id: userId,\n    reply_message: replyMessage,\n    db_query: dbQuery,\n    parsed_value: parsedValue,\n    trigger_campaign_webhook: triggerCampaignWebhook,\n    publish_to_facebook: publishToFacebook,\n    trigger_short_approval: triggerShortApproval,\n    short_id: shortId,\n    short_action: shortAction,\n    campaign_id: campaignId,\n    direct_post_content: directPostContent,\n    opportunity_id: targetOpportunityId\n  }\n}];"
      },
