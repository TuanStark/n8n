    {
      "parameters": {
        "jsCode": "const dbData = $input.first()?.json || {};\nconst parsedContext = $('Parse Slack Action').first()?.json || {};\n\nconst contentToPost = dbData.post_content || dbData.fb_content || dbData.var_a || parsedContext.direct_post_content || '\ud83d\ude80 Thi\u1ebft k\u1ebf Website chu\u1ea9n qu\u1ed1c t\u1ebf c\u00f9ng S.T.A.R.K\\n\\n\ud83d\udcc1 Portfolio ch\u00ednh th\u1ee9c: https://company-plum-rho.vercel.app/\\n\ud83d\udcde Hotline/Zalo: 0845.663.357';\n\nreturn [{\n  json: {\n    postText: contentToPost\n  }\n}];"
      },
